# IfPlay M2 Backend 环境变量示例
# 复制为 .env 并按需填写。真实 Key 只经环境变量注入，不进仓库、不进本文件。

# 数据库（SQLite，默认相对后端项目 data/ 目录；服务重启后数据保留）
IFPLAY_DATABASE_URL=sqlite:///./data/ifplay.db

# GameBundle 共享契约（由 apps/ifplay-m0 运行时 zod schema 生成）
IFPLAY_CONTRACT_PATH=../ifplay-m0/contract/gamebundle-contract.json

# Provider（当前无真实 Key，仅 deterministic-test；真实供应商接入后再配置）
IFPLAY_PROVIDER=deterministic-test

# —— 测试用占位单价（非真实价格，真实单价待供应商确认后注入）——
IFPLAY_INPUT_PRICE_PER_1K=0.002
IFPLAY_OUTPUT_PRICE_PER_1K=0.006
IFPLAY_IMAGE_PRICE=0.1
IFPLAY_BUDGET_PER_TASK=3.0
IFPLAY_SAFETY_MARGIN=0.15
IFPLAY_MAX_OUTPUT_TOKENS=4096
IFPLAY_MAX_IMAGES=3

# Provider 调用约束
IFPLAY_MAX_RETRIES=2
IFPLAY_TIMEOUT_SECONDS=10

# 澄清问题上限 / 每款游戏保留版本数 / 内容修复轮次
IFPLAY_MAX_CLARIFICATIONS=5
IFPLAY_MAX_VERSIONS=10
IFPLAY_MAX_REPAIR_ROUNDS=2
