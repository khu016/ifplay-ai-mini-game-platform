# IfPlay 环境变量模板（不含真实密钥）
# 阶段 0 尚未确定最终模型路由，以下按 PRD 18.1 推荐预填占位；阶段 1 技术适配时细化。
# 所有值仅存本地 .env（已 gitignore），禁止提交或回显。

# 文本模型：阿里云百炼 qwen-flash / qwen-plus（备选 DeepSeek）
MODEL_PROVIDER=mock
MODEL_API_KEY=
MODEL_BASE_URL=

# 生图：阿里云百炼万相 wan2.2-t2i-flash
IMAGE_PROVIDER=mock
IMAGE_API_KEY=

# 内容审核：腾讯云文本/图片内容安全（发布闸门）
MODERATION_PROVIDER=mock
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# 短信验证码：阿里云/腾讯云国内验证码
SMS_PROVIDER=mock
SMS_ACCESS_KEY=
SMS_SECRET_KEY=

# 预算红线（PRD 18–19）
MONTHLY_BUDGET_CNY=100
MONTHLY_WARN_CNY=80
TASK_SOFT_LIMIT_CNY=2
TASK_HARD_LIMIT_CNY=3
