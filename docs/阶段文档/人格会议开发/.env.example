# 复制本文件为 .env 后填写（.env 已被 gitignore，禁止提交）。
# 本项目只用本目录内的配置，不从外层工具包或其他项目读取。
# 注意：只需要填 MODEL_API_KEY 一行，其余保持注释状态即可。

# 模型配置（D4 已定：国内厂商，默认 DeepSeek）
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-chat
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_API_KEY=

# 数据库默认用 sqlite:///./data/app.db，无需配置；如需自定义再取消注释：
# DATABASE_URL=sqlite:///./data/app.db
