# IfPlay OpenGame PoC · 第二轨环境变量样例（阶段二准备）
# 复制为 .env.local 后由本人填写；.env.local / .env 已被 .gitignore 排除，绝不提交。
# 本文件只允许占位值，严禁写入任何真实 Key。

# ---- 双重付费闸门（两个都必须显式为 true 才允许真实模型调用；默认关闭 = 安全失败） ----
ENABLE_PAID_API=false
COST_AUTHORIZED=false

# ---- DeepSeek 官方 OpenAI 兼容接口（主 Agent / 方案 / 代码生成 / 自动修复） ----
# OpenGame 读这三个变量：OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL
# 留空即拒绝启动；OpenGame 自身缺 Key 会直接报错，不会静默改用其他模型。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-flash

# ---- 阿里云万相文生图（独立图片供应商；视频与云端音频保持关闭） ----
OPENGAME_IMAGE_PROVIDER=tongyi
OPENGAME_IMAGE_API_KEY=
OPENGAME_IMAGE_BASE_URL=https://dashscope.aliyuncs.com
OPENGAME_IMAGE_MODEL=wan2.5-t2i-preview

# ---- 遥测 / 用量上报必须关闭（硬兜底：容器 --internal + egress 白名单不放行 RUM 域名） ----
OTEL_SDK_DISABLED=true
GEMINI_TELEMETRY_ENABLED=false

# ---- 网络出口：容器内必须指向白名单代理（唯一出口），禁止宿主机直连 ----
HTTPS_PROXY=http://poc-egress-proxy:3128
HTTP_PROXY=http://poc-egress-proxy:3128
